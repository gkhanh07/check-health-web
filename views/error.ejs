<!DOCTYPE html>
<html>

<head>
  <title>Error</title>
</head>

<body>
  <h1>Error</h1>
  <p>
    <%= message %>
  </p>
  <% if (error && error.status) { %>
    <p>Status: <%= error.status %>
    </p>
    <% } %>
      <% if (error && error.stack) { %>
        <pre><%= error.stack %></pre>
        <% } %>
</body>

</html>